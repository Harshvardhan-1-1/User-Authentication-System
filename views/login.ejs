<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
     <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-screen h-screen bg-zinc-800 flex justify-center items-center">
       <div class="w-96 bg-zinc-300 rounded-xl flex flex-col gap-10 p-5 items-center">
        <h1 class="text-black text-3xl">Login User</h1>
             <form class="flex flex-col gap-5 w-full  " action="/login" method="post">
            <input class="p-3 w-full bg-gray-400 rounded-xl" type="email" placeholder="E-mail" name="email" >
            <input class="p-3 w-full bg-gray-400 rounded-xl" type="password" placeholder="Password" name="password" >
            <input class="p-3 w-full bg-black text-white rounded-xl" type="submit" value="Login">
        </form>

       </div>
    </div>
</body>
</html>